rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // UFO Abduction leaderboard: anyone can read the top scores and add one score; nobody can change or delete.
    match /scores/{id} {
      allow get: if true;
      allow list: if request.query.limit <= 25;
      allow create: if request.resource.data.keys().hasOnly(['name', 'score', 'v'])
        && request.resource.data.name is string
        && request.resource.data.name.matches('^[A-Z0-9 _-]{1,12}$')
        && request.resource.data.score is int
        && request.resource.data.score >= 1
        && request.resource.data.score <= 250000
        && request.resource.data.v == 1;
      allow update, delete: if false;
    }
  }
}
